{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/cli"
    },
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/providers-codex"
    },
    {
      "path": "./packages/providers-google"
    },
    {
      "path": "./packages/credentials"
    },
    {
      "path": "./packages/providers-configurable"
    }
  ]
}
