{
  "name": "imagegencli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Provider-agnostic CLI for programmatic image generation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dorely13/ai-imagegen-cli",
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --force --pretty false",
    "test": "npm run test --workspaces --if-present",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-release.ps1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
